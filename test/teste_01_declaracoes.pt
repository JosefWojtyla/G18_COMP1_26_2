// Teste 01 — Declaracoes simples de variaveis
// Cobre: tipo IDENTIFICADOR; e tipo IDENTIFICADOR <- expressao;
programa {
    funcao inicio() {
        inteiro a;
        real b;
        cadeia c;
        logico d;
        inteiro x = 42;
        real pi = 3.14;
        cadeia nome = "Fulaninho";
        logico ativo = verdadeiro;
    }
}
